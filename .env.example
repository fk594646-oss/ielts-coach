# Copy this file to .env and fill it in. Never commit .env.
PORT=3000

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# From https://platform.claude.com (create an API key and add credit). Leave empty to run without AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limits and options
DAILY_LIMIT=40
ALLOW_SIGNUP=true
PUBLIC_URL=
# Set to 1 when running behind a proxy (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=1
# DATA_DIR=/var/data

# ---- Email (verification + password reset) ----
# Get a key at https://resend.com, paste it below. With a key set, new users must confirm their email.
# Without a key, emails are printed in the terminal (fine for testing on your computer).
RESEND_API_KEY=
# The sender shown on emails. Must be an address on a domain you have verified with your email service.
MAIL_FROM=IELTS Coach <onboarding@resend.dev>
# true = users must verify their email before signing in. Leave empty for automatic (true when a key is set).
REQUIRE_VERIFY=
# IMPORTANT when live: your website address, e.g. https://yourname.com (links in emails use it)
